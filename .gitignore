# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-everflow/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# allow the example env file
!.env.example

# local data
/.data/
/public/uploads/

# reference-site captures (third-party imagery, internal review only)
/docs/screenshots/reference/
/docs/design-review/reference/

# Lighthouse raw reports (regenerable; results summarised in docs/storefront-redesign/README.md)
/docs/storefront-redesign/lighthouse/
/docs/storefront-redesign/lighthouse-before/
