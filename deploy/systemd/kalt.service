# /etc/systemd/system/kalt.service — template.
# Layout: /srv/kalt/current (symlink to the active release), /srv/kalt/shared/.env.local
# (chmod 600, symlinked into each release), uploads in /var/lib/kalt/uploads.
# Run ONE instance: the rate limiter is in memory.

[Unit]
Description=KALT storefront (Next.js)
After=network.target mongod.service
Wants=mongod.service

[Service]
Type=simple
User=kalt
Group=kalt
WorkingDirectory=/srv/kalt/current
Environment=NODE_ENV=production
Environment=APP_ENV=production
ExecStart=/usr/bin/npm start -- -p 3000 -H 127.0.0.1
Restart=on-failure
RestartSec=5
# Logs (JSON lines) go to journald: journalctl -u kalt -f

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/kalt /srv/kalt/current/.next

[Install]
WantedBy=multi-user.target
