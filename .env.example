# --- Base de données (obligatoire) ---
# Atlas : mongodb+srv://user:pass@cluster.xxx.mongodb.net/kalt
# Local : lancez `npm run db:local` puis utilisez la valeur ci-dessous
MONGODB_URI=mongodb://127.0.0.1:27017/kalt

# --- URL publique du site (SEO, Open Graph, liens absolus) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Compte admin initial (lu uniquement par `npm run seed`) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# --- Images distantes autorisées (domaines séparés par des virgules, ex. cdn.exemple.com) ---
IMAGE_REMOTE_HOSTS=

# --- Paiement (laisser vide : aucun prestataire n'est branché) ---
PAYMENT_PROVIDER=
