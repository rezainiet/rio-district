# Copy to .env.local (development) — on the VPS: /srv/rio-district/shared/.env.local,
# owned by the app user, chmod 600, symlinked into each release. Never commit real values.

# --- Environnement : development | staging | production ---
# En production, les scripts de test/démo et `seed --reset` refusent de s'exécuter.
APP_ENV=development

# --- Base de données (obligatoire) ---
# Production : base dédiée « riodistrict », utilisateur avec le seul rôle readWrite sur cette base, ex.
#   mongodb://riodistrict_app:MOT_DE_PASSE@127.0.0.1:27017/riodistrict?authSource=riodistrict
# Atlas : mongodb+srv://riodistrict_app:MOT_DE_PASSE@cluster.xxx.mongodb.net/riodistrict
# Local : lancez `npm run db:local` puis utilisez la valeur ci-dessous
MONGODB_URI=mongodb://127.0.0.1:27017/kalt

# --- URL publique du site (obligatoirement https:// en production, figée par `npm run build`) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Fichiers téléversés : images admin + photos d'avis (dossier persistant, HORS du dossier de release) ---
# Production : /var/lib/rio-district/uploads (obligatoire, vérifié au démarrage)
# Développement : vide = .data/uploads
UPLOAD_DIR=

# --- Compte admin initial (lu uniquement par `npm run seed`) ---
# En production : ne PAS renseigner ; créer l'admin avec `npm run admin:create` (voir docs/DEPLOYMENT.md).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Images distantes autorisées (domaines séparés par des virgules, ex. cdn.exemple.com) ---
IMAGE_REMOTE_HOSTS=

# --- Paiement : désactivé par défaut. Voir docs/EVERFLOW_CHECKOUT.md ---
PAYMENT_PROVIDER=
EVERFLOW_ENABLED=false
# Choix explicite mock | live ; mock exige APP_ENV=development et une base locale rio_everflow_test_*.
EVERFLOW_MODE=mock
EVERFLOW_SINGLE_CHECKOUT_URL=https://www.molipy8trk.com/2J23GL9/TTF23GH/
EVERFLOW_BUNDLE_CHECKOUT_URL=https://www.molipy8trk.com/2J23GL9/TRSKRX3/
EVERFLOW_PUBLIC_ASSET_BASE_URL=https://riodistrict.store
EVERFLOW_COUNTRIES=FR
# Ne changer ces approbations qu'après validation du partenaire et autorisation de la boutique.
EVERFLOW_LIVE_APPROVED=false
EVERFLOW_VARIANTS_APPROVED=false
EVERFLOW_BUNDLE_METADATA_APPROVED=false
EVERFLOW_BUNDLE_IMAGE_URL=
EVERFLOW_SOURCE_ID=
# source_id reste configurable ; aucun secret ne va dans l'URL.
# Avec les deux consentements, le vrai fbclid du visiteur est transmis dans sub1 et fbclid ;
# à défaut, son ScCid Snapchat est transmis dans sub1 et ScCid.
# Paramètres historiques conservés pour les tentatives en attente ; leurs valeurs ne sont plus envoyées dans sub1.
EVERFLOW_SUB1_MODE=disabled
EVERFLOW_PROVIDER_CLICK_ID=
EVERFLOW_SUB1_CORRELATION_APPROVED=false
# Paramètres historiques conservés pour les tentatives en attente ; aucun sub5 n'est ajouté aux liens.
# Le Pixel Meta sur la boutique reste actif avec consentement, sans événement Purchase.
EVERFLOW_PIXEL_PLATFORM=
EVERFLOW_PIXEL_APPROVED=false
EVERFLOW_FACEBOOK_PIXEL_ID=
EVERFLOW_TIKTOK_PIXEL_ID=
EVERFLOW_GOOGLE_PIXEL_ID=
EVERFLOW_GOOGLE_PIXEL_LABEL=
EVERFLOW_SNAPCHAT_PIXEL_ID=
# Réservé au simulateur/build local isolé (.next-everflow), jamais requis en production.
RIO_EVERFLOW_TEST=false
