# Copy to .env.local (development) — on the VPS, the same file name in the app
# directory, owned by the app user, chmod 600. Never commit real values.

# --- Environnement : development | staging | production ---
# En production, les scripts de test/démo et `seed --reset` refusent de s'exécuter.
APP_ENV=development

# --- Base de données (obligatoire) ---
# Production : utilisateur dédié avec le rôle readWrite sur la base kalt uniquement, ex.
#   mongodb://kalt_app:MOT_DE_PASSE@127.0.0.1:27017/kalt?authSource=kalt
# Atlas : mongodb+srv://kalt_app:MOT_DE_PASSE@cluster.xxx.mongodb.net/kalt
# Local : lancez `npm run db:local` puis utilisez la valeur ci-dessous
MONGODB_URI=mongodb://127.0.0.1:27017/kalt

# --- URL publique du site (obligatoirement https:// en production) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Images téléversées depuis l'admin (dossier persistant, HORS du dossier de release) ---
# Production : ex. /var/lib/kalt/uploads (obligatoire, vérifié au démarrage)
# Développement : vide = .data/uploads
UPLOAD_DIR=

# --- Compte admin initial (lu uniquement par `npm run seed`) ---
# En production : renseigner pour le premier seed, puis vider cette valeur.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# --- Images distantes autorisées (domaines séparés par des virgules, ex. cdn.exemple.com) ---
IMAGE_REMOTE_HOSTS=

# --- Paiement (laisser vide : aucun prestataire n'est branché) ---
PAYMENT_PROVIDER=
